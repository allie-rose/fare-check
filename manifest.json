{
  "manifest_version": 3,
  "name": "Fare Check (for delta.com)",
  "description": "A quick read on whether a delta.com fare is a good price for that route, powered by Gemini",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.delta.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.delta.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fare Check"
  }
}
